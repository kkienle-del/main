---
import '@fontsource/archivo-black';
import '@fontsource-variable/archivo';
import '../styles/global.css';
import { SITE, TRACKING } from '../config';
import ConsentBanner from '../components/ConsentBanner.astro';

interface Props {
  title?: string;
  description?: string;
}

const { title = SITE.title, description = SITE.description } = Astro.props;
---

<!doctype html>
<html lang="de">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {/* Kampagnenseite: nicht in den organischen Index, um nicht mit zapf-gmbh.de zu konkurrieren */}
    <meta name="robots" content="noindex, follow" />
    <meta name="theme-color" content="#e2001a" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />

    {/* --- Animations-Bootstrap: muss VOR dem Rendern laufen. ---
        html.js schaltet die versteckten Ausgangszustände der Scroll-Reveals frei
        (ohne JS bleibt die Seite vollständig sichtbar). html.reduce-motion
        bildet die Nutzerpräferenz ab; Testumgebungen können Bewegung über
        window.__ZAPF_FORCE_MOTION erzwingen. */}
    <script is:inline>
      document.documentElement.classList.add('js');
      if (
        window.matchMedia('(prefers-reduced-motion: reduce)').matches &&
        !window.__ZAPF_FORCE_MOTION
      ) {
        document.documentElement.classList.add('reduce-motion');
      }
    </script>

    {/* --- Google Consent Mode v2: Standard = alles verweigert. ---
        gtag.js wird erst nach Einwilligung über den Consent-Banner geladen. */}
    <script is:inline define:vars={{ tracking: TRACKING }}>
      window.dataLayer = window.dataLayer || [];
      function gtag() {
        dataLayer.push(arguments);
      }
      window.gtag = gtag;

      gtag('consent', 'default', {
        ad_storage: 'denied',
        ad_user_data: 'denied',
        ad_personalization: 'denied',
        analytics_storage: 'denied',
        wait_for_update: 500,
      });
      gtag('js', new Date());

      window.__ZAPF_TRACKING = tracking;

      /** Lädt gtag.js und konfiguriert GA4 + Google Ads. Wird nur nach Einwilligung aufgerufen. */
      window.__zapfLoadTracking = function () {
        var t = window.__ZAPF_TRACKING;
        var primaryId = t.ga4Id || t.gadsId;
        if (!primaryId || window.__zapfTrackingLoaded) return;
        window.__zapfTrackingLoaded = true;

        var s = document.createElement('script');
        s.async = true;
        s.src = 'https://www.googletagmanager.com/gtag/js?id=' + encodeURIComponent(primaryId);
        document.head.appendChild(s);

        if (t.ga4Id) gtag('config', t.ga4Id, { anonymize_ip: true });
        if (t.gadsId) gtag('config', t.gadsId);
      };

      /** Feuert die Lead-Conversion (Google Ads) + GA4-Event. */
      window.__zapfTrackConversion = function () {
        var t = window.__ZAPF_TRACKING;
        gtag('event', 'generate_lead', { event_category: 'lead', event_label: 'garagen_funnel' });
        if (t.gadsId && t.gadsConversionLabel) {
          gtag('event', 'conversion', { send_to: t.gadsId + '/' + t.gadsConversionLabel });
        }
      };
    </script>
  </head>
  <body>
    <slot />
    <ConsentBanner />

    {/* --- Animations-System: Reveals, Wort-Masken, Parallax, Magnet-Buttons --- */}
    <script>
      const reduceMotion = document.documentElement.classList.contains('reduce-motion');

      /* [data-words]: Text in Wort-Masken zerlegen (nur reine Text-Elemente) */
      document.querySelectorAll<HTMLElement>('[data-words]').forEach((el) => {
        const words = (el.textContent || '').trim().split(/\s+/);
        el.innerHTML = words
          .map((w, i) => `<span class="w"><span class="w__in" style="--w-delay:${(i * 0.055).toFixed(3)}s">${w}</span></span>`)
          .join(' ');
      });

      /* Reveals: .reveal, [data-words] und .reveal-media beim Scrollen aktivieren */
      const revealEls = document.querySelectorAll<HTMLElement>('.reveal, [data-words], [data-words-observe], .reveal-media');
      if (reduceMotion) {
        revealEls.forEach((el) => el.classList.add('is-visible'));
      } else {
        const io = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (entry.isIntersecting) {
                entry.target.classList.add('is-visible');
                io.unobserve(entry.target);
              }
            }
          },
          { threshold: 0.12, rootMargin: '0px 0px -60px 0px' }
        );
        revealEls.forEach((el) => io.observe(el));
      }

      /* Parallax: [data-parallax="0.2"] bewegt sich relativ zur Scroll-Position.
         Sanft nachgeführt (Lerp) für das „schwebende“ Gefühl. */
      const parallaxEls = Array.from(document.querySelectorAll<HTMLElement>('[data-parallax]')).map((el) => ({
        el,
        speed: parseFloat(el.dataset.parallax || '0.15'),
        current: 0,
      }));
      if (!reduceMotion && parallaxEls.length) {
        const tick = () => {
          const vh = window.innerHeight;
          for (const p of parallaxEls) {
            const rect = p.el.getBoundingClientRect();
            const target = (rect.top + rect.height / 2 - vh / 2) * -p.speed;
            p.current += (target - p.current) * 0.12;
            p.el.style.transform = `translate3d(0, ${p.current.toFixed(2)}px, 0)`;
          }
          requestAnimationFrame(tick);
        };
        requestAnimationFrame(tick);
      }

      /* Magnetische CTA-Buttons (nur präzise Zeiger, keine Touchscreens) */
      if (!reduceMotion && window.matchMedia('(pointer: fine)').matches) {
        document.querySelectorAll<HTMLElement>('.btn--primary').forEach((btn) => {
          btn.addEventListener('mousemove', (e) => {
            const r = btn.getBoundingClientRect();
            const dx = (e.clientX - r.left - r.width / 2) * 0.18;
            const dy = (e.clientY - r.top - r.height / 2) * 0.3;
            btn.style.transform = `translate(${dx.toFixed(1)}px, ${dy.toFixed(1)}px)`;
          });
          btn.addEventListener('mouseleave', () => {
            btn.style.transform = '';
          });
        });

        /* Leichter 3D-Tilt für Modell-Karten */
        document.querySelectorAll<HTMLElement>('.model').forEach((card) => {
          card.addEventListener('mousemove', (e) => {
            const r = card.getBoundingClientRect();
            const rx = ((e.clientY - r.top) / r.height - 0.5) * -7;
            const ry = ((e.clientX - r.left) / r.width - 0.5) * 7;
            card.style.transform = `perspective(48rem) translateY(-6px) rotateX(${rx.toFixed(2)}deg) rotateY(${ry.toFixed(2)}deg)`;
          });
          card.addEventListener('mouseleave', () => {
            card.style.transform = '';
          });
        });
      }

      // Zahlen hochzählen ([data-countup])
      const countEls = document.querySelectorAll<HTMLElement>('[data-countup]');
      const animateCount = (el: HTMLElement) => {
        const target = parseFloat(el.dataset.countup || '0');
        const suffix = el.dataset.suffix || '';
        const duration = 1600;
        const start = performance.now();
        const fmt = new Intl.NumberFormat('de-DE');
        const tick = (now: number) => {
          const p = Math.min((now - start) / duration, 1);
          const eased = 1 - Math.pow(1 - p, 4);
          el.textContent = fmt.format(Math.round(target * eased)) + suffix;
          if (p < 1) requestAnimationFrame(tick);
        };
        requestAnimationFrame(tick);
      };
      if (reduceMotion) {
        countEls.forEach((el) => {
          const fmt = new Intl.NumberFormat('de-DE');
          el.textContent = fmt.format(parseFloat(el.dataset.countup || '0')) + (el.dataset.suffix || '');
        });
      } else {
        const countIo = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (entry.isIntersecting) {
                animateCount(entry.target as HTMLElement);
                countIo.unobserve(entry.target);
              }
            }
          },
          { threshold: 0.4 }
        );
        countEls.forEach((el) => countIo.observe(el));
      }
    </script>
  </body>
</html>
