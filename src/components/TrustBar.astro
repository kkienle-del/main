---
/**
 * Kennzahlen-Leiste direkt unter dem Hero.
 * Zahlen bitte vor Livegang mit Marketing abstimmen (Quelle: zapf-garagen.de).
 */
const stats = [
  { value: 500000, suffix: '+', label: 'gebaute Garagen' },
  { value: 120, suffix: '', label: 'Jahre Unternehmens­geschichte' },
  { value: 4, suffix: '', label: 'Werke in Deutschland' },
] as const;
---

<section class="trustbar" aria-label="ZAPF in Zahlen">
  <div class="container trustbar__inner">
    {
      stats.map((s, i) => (
        <div class="trustbar__stat reveal" style={`--reveal-delay: ${i * 0.1}s`}>
          <span class="trustbar__value" data-countup={s.value} data-suffix={s.suffix}>
            0
          </span>
          <span class="trustbar__label" set:html={s.label} />
        </div>
      ))
    }
    <div class="trustbar__stat trustbar__stat--badge reveal" style="--reveal-delay: 0.3s">
      <span class="trustbar__value trustbar__value--text">100&nbsp;%</span>
      <span class="trustbar__label">Made in Germany</span>
    </div>
  </div>
</section>

<style>
  .trustbar {
    background: var(--ink);
    color: var(--white);
    padding-block: clamp(2rem, 4vw, 3rem);
  }

  .trustbar__inner {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1.5rem;
  }

  .trustbar__stat {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
    padding-left: 1.1rem;
    border-left: 3px solid var(--red);
  }

  .trustbar__value {
    font-family: var(--font-display);
    font-size: clamp(1.7rem, 3.4vw, 2.6rem);
    line-height: 1;
    letter-spacing: -0.01em;
    font-variant-numeric: tabular-nums;
  }

  .trustbar__label {
    font-size: 0.875rem;
    color: rgba(255, 255, 255, 0.65);
    line-height: 1.35;
  }

  @media (max-width: 48rem) {
    .trustbar__inner {
      grid-template-columns: repeat(2, 1fr);
      gap: 1.75rem 1rem;
    }
  }
</style>
