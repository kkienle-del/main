---
/**
 * Zentrales ZAPF-Logo für Header und Footer.
 *
 * Offizielles Logo einbinden: Datei einfach als
 *   public/images/zapf-logo.svg   (oder .png)
 * ins Projekt legen – sie wird beim nächsten Build automatisch verwendet.
 * Solange keine Datei vorliegt, rendert die Komponente den nachgebauten
 * Schriftzug (rotes Feld + ZAPF) als Fallback.
 */
import fs from 'node:fs';

interface Props {
  /** Höhe des Logos, z. B. '2.25rem' (Header) oder '2rem' (Footer) */
  height?: string;
}

const { height = '2.25rem' } = Astro.props;

const logoFile = ['zapf-logo.svg', 'zapf-logo.png'].find((f) =>
  fs.existsSync(new URL(`../../public/images/${f}`, import.meta.url))
);
---

{
  logoFile ? (
    <img src={`/images/${logoFile}`} alt="ZAPF – die Garage." class="logo" style={`height: ${height}`} />
  ) : (
    <span class="logo logo--fallback" style={`height: ${height}`} role="img" aria-label="ZAPF">
      ZAPF
    </span>
  )
}

<style>
  .logo {
    display: block;
    width: auto;
  }

  .logo--fallback {
    display: inline-flex;
    align-items: center;
    font-family: var(--font-display);
    font-size: 1.6rem;
    line-height: 1;
    color: var(--white);
    background: var(--red);
    padding-inline: 0.55rem;
    letter-spacing: 0.02em;
  }
</style>
