---
import { CONTACT } from '../config';
---

<header class="header" id="site-header">
  <div class="container header__inner">
    <a href="#top" class="header__brand" aria-label="ZAPF – zur Startseite der Landingpage">
      <span class="header__logo">ZAPF</span>
      <span class="header__claim">die Garage.</span>
    </a>

    <div class="header__actions">
      <a href={`tel:${CONTACT.phoneLink}`} class="header__phone">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
          <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.13.96.36 1.9.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.91.34 1.85.57 2.81.7A2 2 0 0 1 22 16.92z" />
        </svg>
        <span class="header__phone-label">
          <small>Direkt beraten lassen</small>
          {CONTACT.phoneDisplay}
        </span>
      </a>
      <a href="#angebot" class="btn btn--primary header__cta">Angebot sichern</a>
    </div>
  </div>
</header>

<style>
  .header {
    position: fixed;
    inset-inline: 0;
    top: 0;
    z-index: 80;
    background: rgba(255, 255, 255, 0.92);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border-bottom: 1px solid transparent;
    transition: border-color 0.3s ease, box-shadow 0.3s ease;
  }

  .header.is-scrolled {
    border-bottom-color: var(--line);
    box-shadow: 0 8px 30px -18px rgba(23, 25, 30, 0.3);
  }

  .header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding-block: 0.75rem;
    transition: padding 0.3s var(--ease-out);
  }

  .header.is-scrolled .header__inner {
    padding-block: 0.5rem;
  }

  .header__brand {
    display: flex;
    align-items: baseline;
    gap: 0.6rem;
    text-decoration: none;
  }

  .header__logo {
    font-family: var(--font-display);
    font-size: 1.6rem;
    line-height: 1;
    color: var(--white);
    background: var(--red);
    padding: 0.3rem 0.55rem 0.25rem;
    letter-spacing: 0.02em;
  }

  .header__claim {
    font-weight: 700;
    font-size: 1.05rem;
    color: var(--ink);
    letter-spacing: -0.01em;
  }

  .header__actions {
    display: flex;
    align-items: center;
    gap: 1.25rem;
  }

  .header__phone {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    text-decoration: none;
    font-weight: 800;
    font-size: 1.05rem;
    color: var(--ink);
    transition: color 0.15s ease;
  }

  .header__phone:hover {
    color: var(--red);
  }

  .header__phone svg {
    width: 1.4rem;
    height: 1.4rem;
    color: var(--red);
  }

  .header__phone-label {
    display: flex;
    flex-direction: column;
    line-height: 1.15;
  }

  .header__phone-label small {
    font-size: 0.6875rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--gray);
  }

  .header__cta {
    padding: 0.75rem 1.4rem;
    font-size: 0.95rem;
  }

  @media (max-width: 48rem) {
    .header__claim,
    .header__phone-label {
      display: none;
    }

    .header__phone svg {
      width: 1.6rem;
      height: 1.6rem;
    }

    .header__phone {
      padding: 0.5rem;
    }

    .header__cta {
      padding: 0.65rem 1.1rem;
      font-size: 0.875rem;
    }
  }
</style>

<script>
  const header = document.getElementById('site-header') as HTMLElement;
  const onScroll = () => header.classList.toggle('is-scrolled', window.scrollY > 12);
  onScroll();
  window.addEventListener('scroll', onScroll, { passive: true });
</script>
