---
import { CONTACT } from '../config';
---

<section class="final section section--ink">
  <span class="final__ghost" data-parallax="0.14" aria-hidden="true">ZAPF</span>
  <div class="container final__inner">
    <div class="final__copy">
      <h2 class="display final__headline" data-words-observe>
        <span class="final__line"><span class="final__line-in">Bereit für Ihre</span></span>
        <span class="final__line"><span class="final__line-in final__accent" style="--line-delay: 0.14s">neue Garage?</span></span>
      </h2>
      <p class="final__sub reveal" style="--reveal-delay: 0.3s">
        In 60 Sekunden angefragt, in wenigen Stunden montiert – und gebaut für Generationen.
      </p>
    </div>
    <div class="final__actions reveal" style="--reveal-delay: 0.15s">
      <a href="#angebot" class="btn btn--primary final__btn">Jetzt kostenloses Angebot sichern</a>
      <a href={`tel:${CONTACT.phoneLink}`} class="btn btn--ghost-light final__btn">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
          <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.13.96.36 1.9.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.91.34 1.85.57 2.81.7A2 2 0 0 1 22 16.92z" />
        </svg>
        {CONTACT.phoneDisplay}
      </a>
      <p class="final__hint">Mo.–Fr. erreichbar &middot; Beratung kostenlos &amp; unverbindlich</p>
    </div>
  </div>
</section>

<style>
  .final {
    position: relative;
    overflow: hidden;
  }

  /* großes, angeschnittenes ZAPF-Wortzeichen mit Parallax-Bewegung */
  .final__ghost {
    position: absolute;
    right: -2rem;
    bottom: -3rem;
    font-family: var(--font-display);
    font-size: clamp(10rem, 26vw, 22rem);
    line-height: 0.8;
    color: rgba(255, 255, 255, 0.04);
    pointer-events: none;
    user-select: none;
    will-change: transform;
  }

  .final__line {
    display: block;
    overflow: hidden;
    padding-bottom: 0.05em;
    margin-bottom: -0.05em;
  }

  .final__line-in {
    display: inline-block;
    transform: translateY(115%);
    transition: transform 0.95s var(--ease-out);
    transition-delay: var(--line-delay, 0s);
  }

  [data-words-observe].is-visible .final__line-in {
    transform: none;
  }

  @media (prefers-reduced-motion: reduce) {
    .final__line-in {
      transform: none;
    }
  }

  .final__inner {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1.2fr) minmax(0, 1fr);
    gap: clamp(2rem, 5vw, 4rem);
    align-items: center;
  }

  .final__headline {
    font-size: clamp(2.2rem, 5vw, 3.8rem);
  }

  .final__accent {
    color: var(--red);
  }

  .final__sub {
    margin: 1.25rem 0 0;
    font-size: 1.1rem;
    color: rgba(255, 255, 255, 0.65);
    max-width: 30rem;
  }

  .final__actions {
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
  }

  .final__btn {
    width: 100%;
  }

  .final__btn svg {
    width: 1.2rem;
    height: 1.2rem;
  }

  .final__hint {
    margin: 0.25rem 0 0;
    text-align: center;
    font-size: 0.8rem;
    color: rgba(255, 255, 255, 0.5);
  }

  @media (max-width: 52rem) {
    .final__inner {
      grid-template-columns: 1fr;
    }
  }
</style>
