---
/** Ablauf in 4 Schritten – nimmt die Hemmschwelle vor der Anfrage. */
const steps = [
  {
    title: 'Anfrage in 60 Sekunden',
    text: '4 kurze Fragen beantworten – kostenlos und unverbindlich. Kein Kleingedrucktes.',
  },
  {
    title: 'Persönliche Beratung',
    text: 'Ihr ZAPF Fachberater meldet sich, klärt alle Details und erstellt Ihr Festpreis-Angebot.',
  },
  {
    title: 'Produktion im Werk',
    text: 'Ihre Garage wird in einem unserer vier deutschen Werke millimetergenau gefertigt.',
  },
  {
    title: 'Lieferung & Montage',
    text: 'Anlieferung per Spezialfahrzeug, Aufstellung in wenigen Stunden – fertig ist Ihre Garage.',
  },
] as const;
---

<section class="section process-section" id="ablauf">
  <span class="ghost" data-parallax="0.1" aria-hidden="true">Ablauf</span>
  <div class="container">
    <div class="section-head">
      <p class="kicker reveal">So einfach geht’s</p>
      <h2 class="display" data-words>In 4 Schritten zur eigenen Garage</h2>
    </div>

    <ol class="process">
      {
        steps.map((s, i) => (
          <li class="process__step reveal" style={`--reveal-delay: ${i * 0.14}s`}>
            <span class="process__num" style={`--num-delay: ${i * 0.14 + 0.35}s`}>{i + 1}</span>
            <h3 class="process__title">{s.title}</h3>
            <p class="process__text">{s.text}</p>
          </li>
        ))
      }
    </ol>

    <div class="process__cta reveal">
      <a href="#angebot" class="btn btn--primary">Schritt 1 starten – Angebot anfordern</a>
    </div>
  </div>
</section>

<style>
  .process {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1.25rem;
    counter-reset: step;
  }

  .process__step {
    position: relative;
    padding: 1.75rem 1.5rem 1.5rem;
    background: var(--concrete);
    border-radius: var(--radius-lg);
    overflow: hidden;
  }

  /* Verbindungslinie zwischen den Schritten (nur Desktop) */
  .process__step:not(:last-child)::after {
    content: '';
    position: absolute;
    top: 2.9rem;
    right: -1.25rem;
    width: 1.25rem;
    border-top: 2px dashed var(--line);
  }

  .process-section {
    position: relative;
    overflow: hidden;
  }

  .process__num {
    display: grid;
    place-items: center;
    width: 2.5rem;
    height: 2.5rem;
    background: var(--ink);
    color: var(--white);
    font-family: var(--font-display);
    font-size: 1.1rem;
    border-radius: 50%;
    transform: scale(0);
  }

  /* Nummern poppen nacheinander auf, sobald der Schritt sichtbar wird */
  .reveal.is-visible .process__num {
    animation: num-pop 0.55s var(--ease-snap) var(--num-delay, 0.35s) forwards;
  }

  @keyframes num-pop {
    to {
      transform: scale(1);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .process__num {
      transform: none;
    }
  }

  .process__step:first-child .process__num {
    background: var(--red);
  }

  .process__title {
    margin-top: 1.1rem;
    font-size: 1.05rem;
    letter-spacing: -0.01em;
  }

  .process__text {
    margin: 0.5rem 0 0;
    font-size: 0.9rem;
    line-height: 1.55;
    color: var(--gray);
  }

  .process__cta {
    margin-top: 2.5rem;
    text-align: center;
  }

  @media (max-width: 56rem) {
    .process {
      grid-template-columns: repeat(2, 1fr);
    }

    .process__step:not(:last-child)::after {
      display: none;
    }
  }

  @media (max-width: 30rem) {
    .process {
      grid-template-columns: 1fr;
    }
  }
</style>
