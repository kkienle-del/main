---
import LeadFunnel from './LeadFunnel.astro';
---

<section class="hero" id="top">
  <div class="hero__grid" aria-hidden="true"></div>
  <div class="container hero__inner">
    <div class="hero__copy">
      <p class="kicker reveal">Fertiggaragen direkt vom Marktführer</p>
      <h1 class="display hero__headline">
        <span class="reveal" style="--reveal-delay: 0.05s">Ihre Garage.</span>
        <span class="reveal" style="--reveal-delay: 0.15s">Aus Beton.</span>
        <span class="hero__headline-accent reveal" style="--reveal-delay: 0.25s">Fürs Leben.</span>
      </h1>
      <p class="hero__sub reveal" style="--reveal-delay: 0.35s">
        Über <strong>500.000 gebaute Garagen</strong>, 100&nbsp;% Made in Germany und ein
        Festpreis, auf den Sie sich verlassen können. Beantworten Sie 4 kurze Fragen –
        wir melden uns mit Ihrem persönlichen Angebot.
      </p>
      <ul class="hero__points reveal" style="--reveal-delay: 0.45s">
        <li>Kostenlose &amp; unverbindliche Beratung</li>
        <li>Montage in wenigen Stunden</li>
        <li>Alles aus einer Hand – von Planung bis Aufbau</li>
      </ul>
      <div class="hero__cta-row reveal" style="--reveal-delay: 0.55s">
        <a href="#angebot" class="btn btn--primary hero__cta-mobile">Jetzt Angebot sichern</a>
      </div>

      {/* Line-Art: technische Zeichnung einer Doppelgarage, zeichnet sich beim Laden selbst */}
      <svg class="hero__drawing" viewBox="0 0 420 190" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
        <g class="hero__drawing-paths">
          <path d="M20 170 H400" />
          <rect x="60" y="50" width="300" height="120" />
          <path d="M60 50 L210 26 L360 50" />
          <rect x="84" y="76" width="116" height="94" />
          <rect x="220" y="76" width="116" height="94" />
          <path d="M84 100 H200 M84 124 H200 M84 148 H200" stroke-width="1.25" />
          <path d="M220 100 H336 M220 124 H336 M220 148 H336" stroke-width="1.25" />
          <path d="M40 170 V60 M40 60 l-5 8 M40 60 l5 8 M40 170 l-5 -8 M40 170 l5 -8" stroke-width="1.25" />
        </g>
        <text x="14" y="118" class="hero__drawing-label" transform="rotate(-90 14 118)">H 2,55 m</text>
      </svg>
    </div>

    <div class="hero__form reveal reveal--right" style="--reveal-delay: 0.3s">
      <LeadFunnel />
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    background: var(--concrete);
    padding-top: clamp(6.5rem, 12vw, 9rem);
    padding-bottom: clamp(3rem, 6vw, 5.5rem);
    overflow: hidden;
  }

  /* dezentes Blaupausen-Raster im Hintergrund */
  .hero__grid {
    position: absolute;
    inset: 0;
    background-image: linear-gradient(rgba(23, 25, 30, 0.045) 1px, transparent 1px),
      linear-gradient(90deg, rgba(23, 25, 30, 0.045) 1px, transparent 1px);
    background-size: 48px 48px;
    mask-image: radial-gradient(ellipse 90% 80% at 30% 20%, black 30%, transparent 75%);
    -webkit-mask-image: radial-gradient(ellipse 90% 80% at 30% 20%, black 30%, transparent 75%);
    pointer-events: none;
  }

  .hero__inner {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(0, 26.5rem);
    gap: clamp(2rem, 5vw, 4.5rem);
    align-items: start;
  }

  .hero__headline {
    font-size: clamp(2.6rem, 6vw, 4.6rem);
    margin-top: 1.1rem;
    line-height: 0.98;
  }

  .hero__headline span {
    display: block;
  }

  .hero__headline-accent {
    color: var(--red);
  }

  .hero__sub {
    margin: 1.5rem 0 0;
    font-size: clamp(1.05rem, 1.6vw, 1.2rem);
    line-height: 1.6;
    color: var(--ink-soft);
    max-width: 34rem;
  }

  .hero__points {
    list-style: none;
    padding: 0;
    margin: 1.5rem 0 0;
    display: grid;
    gap: 0.55rem;
  }

  .hero__points li {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    font-weight: 600;
    font-size: 0.98rem;
  }

  .hero__points li::before {
    content: '';
    flex: none;
    width: 1.25rem;
    height: 1.25rem;
    background: var(--red);
    clip-path: polygon(18% 48%, 40% 70%, 82% 26%, 92% 36%, 40% 88%, 8% 58%);
  }

  .hero__cta-row {
    margin-top: 1.75rem;
  }

  .hero__cta-mobile {
    display: none;
  }

  .hero__drawing {
    margin-top: clamp(2rem, 4vw, 3.5rem);
    max-width: 26rem;
    color: rgba(23, 25, 30, 0.5);
  }

  .hero__drawing-paths path,
  .hero__drawing-paths rect {
    stroke-dasharray: 1200;
    stroke-dashoffset: 1200;
    animation: draw 2.8s var(--ease-out) 0.6s forwards;
  }

  .hero__drawing-label {
    font-family: var(--font-body);
    font-size: 0.55rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    fill: rgba(23, 25, 30, 0.55);
    stroke: none;
    opacity: 0;
    animation: fade-in 0.8s ease 2.6s forwards;
  }

  @keyframes draw {
    to {
      stroke-dashoffset: 0;
    }
  }

  @keyframes fade-in {
    to {
      opacity: 1;
    }
  }

  @media (max-width: 60rem) {
    .hero__inner {
      grid-template-columns: 1fr;
    }

    .hero__form {
      order: 2;
    }

    .hero__cta-mobile {
      display: inline-flex;
      width: 100%;
    }

    .hero__drawing {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero__drawing-paths path,
    .hero__drawing-paths rect {
      stroke-dashoffset: 0;
      animation: none;
    }

    .hero__drawing-label {
      opacity: 1;
      animation: none;
    }
  }
</style>
