---
import LeadFunnel from './LeadFunnel.astro';
---

<section class="hero" id="top">
  <div class="hero__grid" data-parallax="0.08" aria-hidden="true"></div>
  <div class="container hero__inner">
    <div class="hero__copy">
      <p class="kicker hero__kicker">Fertiggaragen direkt vom Marktführer</p>
      <h1 class="display hero__headline">
        <span class="hero__line"><span class="hero__line-in" style="--line-delay: 0.15s">Ihre Garage.</span></span>
        <span class="hero__line"><span class="hero__line-in" style="--line-delay: 0.28s">Aus Beton.</span></span>
        <span class="hero__line"><span class="hero__line-in hero__line-in--accent" style="--line-delay: 0.41s">Fürs Leben.</span></span>
      </h1>
      <p class="hero__sub">
        Über <strong>450.000 gebaute Garagen</strong>, 100&nbsp;% Made in Germany und ein
        Festpreis, auf den Sie sich verlassen können. Beantworten Sie 4 kurze Fragen –
        wir melden uns mit Ihrem persönlichen Angebot.
      </p>
      <ul class="hero__points">
        <li style="--point-delay: 0.85s">Kostenlose &amp; unverbindliche Beratung</li>
        <li style="--point-delay: 0.95s">Montage in wenigen Stunden</li>
        <li style="--point-delay: 1.05s">Alles aus einer Hand – von Planung bis Aufbau</li>
      </ul>
      <div class="hero__cta-row">
        <a href="#angebot" class="btn btn--primary hero__cta-mobile">Jetzt Angebot sichern</a>
      </div>

      {/* Line-Art: technische Zeichnung einer Doppelgarage, zeichnet sich beim Laden selbst */}
      <svg class="hero__drawing" data-parallax="0.06" viewBox="0 0 420 190" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
        <g class="hero__drawing-paths">
          <path d="M20 170 H400" />
          <rect x="60" y="50" width="300" height="120" />
          <path d="M60 50 L210 26 L360 50" />
          <rect x="84" y="76" width="116" height="94" />
          <rect x="220" y="76" width="116" height="94" />
          <path d="M84 100 H200 M84 124 H200 M84 148 H200" stroke-width="1.25" />
          <path d="M220 100 H336 M220 124 H336 M220 148 H336" stroke-width="1.25" />
          <path d="M40 170 V60 M40 60 l-5 8 M40 60 l5 8 M40 170 l-5 -8 M40 170 l5 -8" stroke-width="1.25" />
        </g>
        <text x="14" y="118" class="hero__drawing-label" transform="rotate(-90 14 118)">H 2,55 m</text>
      </svg>
    </div>

    <div class="hero__form">
      {/* Rotierendes Siegel – überlappt die Funnel-Karte an der Ecke */}
      <div class="hero__badge" aria-hidden="true">
        <svg class="hero__badge-ring" viewBox="0 0 120 120">
          <defs>
            <path id="hero-badge-path" d="M 60,60 m -46,0 a 46,46 0 1,1 92,0 a 46,46 0 1,1 -92,0" fill="none"></path>
          </defs>
          <text class="hero__badge-text">
            <textPath href="#hero-badge-path">Seit 1904 · Made in Germany ·</textPath>
          </text>
        </svg>
        <span class="hero__badge-core">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="square">
            <path d="M5 13l5 5L20 7" />
          </svg>
        </span>
      </div>
      <LeadFunnel />
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    background: var(--concrete);
    padding-top: clamp(6.5rem, 12vw, 9rem);
    padding-bottom: clamp(3rem, 6vw, 5.5rem);
    overflow: hidden;
  }

  /* dezentes Blaupausen-Raster, wandert langsam + Parallax beim Scrollen */
  .hero__grid {
    position: absolute;
    inset: -10% 0;
    background-image: linear-gradient(rgba(23, 25, 30, 0.05) 1px, transparent 1px),
      linear-gradient(90deg, rgba(23, 25, 30, 0.05) 1px, transparent 1px);
    background-size: 48px 48px;
    mask-image: radial-gradient(ellipse 90% 80% at 30% 20%, black 30%, transparent 75%);
    -webkit-mask-image: radial-gradient(ellipse 90% 80% at 30% 20%, black 30%, transparent 75%);
    pointer-events: none;
    animation: grid-pan 40s linear infinite;
  }

  @keyframes grid-pan {
    to {
      background-position: 48px 48px;
    }
  }

  .hero__inner {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(0, 26.5rem);
    gap: clamp(2rem, 5vw, 4.5rem);
    align-items: start;
  }

  /* ---------- Lade-Sequenz ---------- */

  .hero__kicker {
    opacity: 0;
    animation: hero-fade 0.7s var(--ease-out) 0.05s forwards;
  }

  .hero__headline {
    font-size: clamp(2.6rem, 6vw, 4.6rem);
    margin-top: 1.1rem;
    line-height: 0.98;
  }

  .hero__line {
    display: block;
    overflow: hidden;
    padding-bottom: 0.04em;
    margin-bottom: -0.04em;
  }

  .hero__line-in {
    display: inline-block;
    transform: translateY(115%);
    animation: hero-rise 0.95s var(--ease-out) var(--line-delay, 0.15s) forwards;
  }

  .hero__line-in--accent {
    color: var(--red);
  }

  .hero__sub {
    margin: 1.5rem 0 0;
    font-size: clamp(1.05rem, 1.6vw, 1.2rem);
    line-height: 1.6;
    color: var(--ink-soft);
    max-width: 34rem;
    opacity: 0;
    animation: hero-fade 0.8s var(--ease-out) 0.65s forwards;
  }

  .hero__points {
    list-style: none;
    padding: 0;
    margin: 1.5rem 0 0;
    display: grid;
    gap: 0.55rem;
  }

  .hero__points li {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    font-weight: 600;
    font-size: 0.98rem;
    opacity: 0;
    transform: translateX(-18px);
    animation: hero-slide 0.6s var(--ease-out) var(--point-delay, 0.85s) forwards;
  }

  .hero__points li::before {
    content: '';
    flex: none;
    width: 1.25rem;
    height: 1.25rem;
    background: var(--red);
    clip-path: polygon(18% 48%, 40% 70%, 82% 26%, 92% 36%, 40% 88%, 8% 58%);
  }

  .hero__cta-row {
    margin-top: 1.75rem;
    opacity: 0;
    animation: hero-fade 0.7s var(--ease-out) 1.15s forwards;
  }

  .hero__cta-mobile {
    display: none;
  }

  .hero__form {
    position: relative;
    opacity: 0;
    transform: translateY(46px) scale(0.985);
    animation: hero-card 0.9s var(--ease-out) 0.5s forwards;
  }

  /* ---------- Rotierendes Siegel ---------- */

  .hero__badge {
    position: absolute;
    top: -4.1rem;
    left: -4.3rem;
    width: 7.4rem;
    height: 7.4rem;
    z-index: 3;
    display: grid;
    place-items: center;
  }

  .hero__badge-ring {
    position: absolute;
    inset: 0;
    animation: badge-spin 22s linear infinite;
  }

  .hero__badge-text {
    font-family: var(--font-body);
    font-size: 0.7rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.26em;
    fill: var(--ink);
  }

  .hero__badge-core {
    width: 2.9rem;
    height: 2.9rem;
    background: var(--red);
    border-radius: 50%;
    display: grid;
    place-items: center;
    color: var(--white);
    box-shadow: 0 8px 18px -6px rgba(226, 0, 26, 0.55);
  }

  .hero__badge-core svg {
    width: 1.3rem;
    height: 1.3rem;
  }

  @keyframes badge-spin {
    to {
      transform: rotate(360deg);
    }
  }

  @keyframes hero-fade {
    to {
      opacity: 1;
    }
  }

  @keyframes hero-rise {
    to {
      transform: none;
    }
  }

  @keyframes hero-slide {
    to {
      opacity: 1;
      transform: none;
    }
  }

  @keyframes hero-card {
    to {
      opacity: 1;
      transform: none;
    }
  }

  /* ---------- Technische Zeichnung ---------- */

  .hero__drawing {
    margin-top: clamp(2rem, 4vw, 3.5rem);
    max-width: 26rem;
    color: rgba(23, 25, 30, 0.5);
  }

  .hero__drawing-paths path,
  .hero__drawing-paths rect {
    stroke-dasharray: 1200;
    stroke-dashoffset: 1200;
    animation: draw 3s var(--ease-out) 1s forwards;
  }

  .hero__drawing-label {
    font-family: var(--font-body);
    font-size: 0.55rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    fill: rgba(23, 25, 30, 0.55);
    stroke: none;
    opacity: 0;
    animation: hero-fade 0.8s ease 3.2s forwards;
  }

  @keyframes draw {
    to {
      stroke-dashoffset: 0;
    }
  }

  @media (max-width: 60rem) {
    .hero__inner {
      grid-template-columns: 1fr;
    }

    .hero__form {
      order: 2;
    }

    .hero__cta-mobile {
      display: inline-flex;
      width: 100%;
    }

    .hero__drawing {
      display: none;
    }

    .hero__badge {
      display: none;
    }
  }
</style>
