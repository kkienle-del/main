---
import { CONTACT, LEGAL } from '../config';
const year = new Date().getFullYear();
---

<footer class="footer">
  <div class="container footer__inner">
    <div class="footer__brand">
      <span class="footer__logo">ZAPF</span>
      <p class="footer__tagline">die Garage.</p>
      <p class="footer__company">
        ZAPF GmbH &middot; Nürnberger Straße 38 &middot; 95448 Bayreuth<br />
        Tel. <a href={`tel:${CONTACT.phoneLink}`}>{CONTACT.phoneDisplay}</a>
      </p>
    </div>
    <nav class="footer__nav" aria-label="Rechtliches">
      <a href={LEGAL.impressum} target="_blank" rel="noopener">Impressum</a>
      <a href={LEGAL.datenschutz} target="_blank" rel="noopener">Datenschutz</a>
      <button type="button" class="footer__consent-link" id="footer-consent">Cookie-Einstellungen</button>
    </nav>
  </div>
  <div class="container footer__bottom">
    <p>© {year} ZAPF GmbH. Alle Rechte vorbehalten.</p>
  </div>
</footer>

<style>
  .footer {
    background: var(--ink);
    color: rgba(255, 255, 255, 0.7);
    border-top: 1px solid rgba(255, 255, 255, 0.1);
    padding-block: 2.75rem 1.5rem;
    font-size: 0.9rem;
  }

  .footer__inner {
    display: flex;
    justify-content: space-between;
    gap: 2rem;
    flex-wrap: wrap;
  }

  .footer__logo {
    display: inline-block;
    font-family: var(--font-display);
    font-size: 1.4rem;
    color: var(--white);
    background: var(--red);
    padding: 0.25rem 0.5rem 0.2rem;
  }

  .footer__tagline {
    margin: 0.5rem 0 1rem;
    font-weight: 700;
    color: var(--white);
  }

  .footer__company {
    margin: 0;
    line-height: 1.7;
  }

  .footer__company a {
    color: inherit;
  }

  .footer__nav {
    display: flex;
    align-items: flex-start;
    gap: 1.75rem;
    flex-wrap: wrap;
  }

  .footer__nav a,
  .footer__consent-link {
    color: rgba(255, 255, 255, 0.7);
    text-decoration: none;
    font-weight: 600;
    background: none;
    border: 0;
    padding: 0;
    font-size: 0.9rem;
    transition: color 0.15s ease;
  }

  .footer__nav a:hover,
  .footer__consent-link:hover {
    color: var(--white);
  }

  .footer__bottom {
    margin-top: 2rem;
    padding-top: 1.25rem;
    border-top: 1px solid rgba(255, 255, 255, 0.1);
    font-size: 0.8rem;
    color: rgba(255, 255, 255, 0.4);
  }

  .footer__bottom p {
    margin: 0;
  }
</style>

<script>
  document.getElementById('footer-consent')?.addEventListener('click', () => {
    (window as any).__zapfOpenConsent?.();
  });
</script>
