---
/**
 * !!! WICHTIG (rechtlich): Die folgenden Zitate sind PLATZHALTER.
 * Vor Livegang zwingend durch echte, dokumentierte Kundenstimmen ersetzen
 * (UWG: erfundene Bewertungen sind abmahnfähig). Siehe README.
 *
 * Darstellung: endlos laufendes Zitat-Band, pausiert bei Hover.
 */
const testimonials = [
  {
    quote:
      'Von der Beratung bis zur Montage lief alles wie am Schnürchen. Morgens kam der Kran, mittags stand die Garage.',
    name: 'M. Beispiel',
    meta: 'Doppelgarage · Platzhalter-Zitat',
  },
  {
    quote:
      'Der Festpreis hat uns überzeugt – keine Nachträge, keine Überraschungen. Genau so stellt man sich das vor.',
    name: 'S. Beispiel',
    meta: 'Einzelgarage · Platzhalter-Zitat',
  },
  {
    quote:
      'Wir haben lange verglichen. Am Ende war ZAPF bei Qualität und Abwicklung einfach eine andere Liga.',
    name: 'F. Beispiel',
    meta: 'Großraumgarage · Platzhalter-Zitat',
  },
  {
    quote:
      'Fundamentplan kam sofort, der Aufbau war ein Termin von zwei Stunden. So unkompliziert kann Bauen sein.',
    name: 'K. Beispiel',
    meta: 'Reihengarage · Platzhalter-Zitat',
  },
] as const;
---

<section class="section section--ink quotes-section" id="stimmen">
  <span class="ghost" data-parallax="0.1" aria-hidden="true">Stimmen</span>
  <div class="container">
    <div class="section-head">
      <p class="kicker kicker--light kicker--rule reveal"><span>Kundenstimmen</span><i class="kicker__line"></i><span class="kicker__idx">04</span></p>
      <h2 class="display" data-words>Darauf bauen unsere Kunden</h2>
    </div>
  </div>

  <div class="quotes reveal">
    <div class="quotes__track">
      {
        [0, 1].map((copy) => (
          <div class="quotes__group" aria-hidden={copy === 1 ? 'true' : undefined}>
            {testimonials.map((t) => (
              <figure class="quote">
                <div class="quote__mark" aria-hidden="true">
                  „
                </div>
                <blockquote class="quote__text">{t.quote}</blockquote>
                <figcaption class="quote__caption">
                  <span class="quote__name">{t.name}</span>
                  <span class="quote__meta">{t.meta}</span>
                </figcaption>
              </figure>
            ))}
          </div>
        ))
      }
    </div>
  </div>
</section>

<style>
  .quotes-section {
    position: relative;
    overflow: hidden;
  }

  .quotes {
    overflow: hidden;
    /* weiche Kanten links/rechts */
    mask-image: linear-gradient(90deg, transparent, black 8%, black 92%, transparent);
    -webkit-mask-image: linear-gradient(90deg, transparent, black 8%, black 92%, transparent);
  }

  .quotes__track {
    display: flex;
    width: max-content;
    animation: quotes-scroll 42s linear infinite;
  }

  .quotes:hover .quotes__track {
    animation-play-state: paused;
  }

  .quotes__group {
    display: flex;
    flex: none;
  }

  .quote {
    width: clamp(19rem, 28vw, 24rem);
    flex: none;
    margin: 0 0.65rem;
    padding: 1.75rem;
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: var(--radius-lg);
    display: flex;
    flex-direction: column;
    transition: border-color 0.25s ease, background-color 0.25s ease;
  }

  .quote:hover {
    border-color: rgba(255, 255, 255, 0.35);
    background: rgba(255, 255, 255, 0.08);
  }

  .quote__mark {
    font-family: var(--font-display);
    font-size: 3rem;
    line-height: 0.6;
    color: var(--red);
    margin-bottom: 1rem;
  }

  .quote__text {
    margin: 0;
    font-size: 1rem;
    line-height: 1.65;
    color: rgba(255, 255, 255, 0.85);
    flex: 1;
  }

  .quote__caption {
    margin-top: 1.5rem;
    padding-top: 1rem;
    border-top: 1px solid rgba(255, 255, 255, 0.12);
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
  }

  .quote__name {
    font-weight: 800;
    font-size: 0.95rem;
  }

  .quote__meta {
    font-size: 0.8rem;
    color: rgba(255, 255, 255, 0.5);
  }

  @keyframes quotes-scroll {
    to {
      transform: translateX(-50%);
    }
  }
</style>
