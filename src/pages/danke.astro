---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { CONTACT } from '../config';
---

<Base
  title="Vielen Dank für Ihre Anfrage | ZAPF Fertiggaragen"
  description="Ihre Anfrage ist bei uns eingegangen – ein ZAPF Fachberater meldet sich in Kürze mit Ihrem persönlichen Angebot."
>
  <Header />
  <main class="thanks">
    <div class="container thanks__inner">
      <div class="thanks__check" aria-hidden="true">
        <svg viewBox="0 0 52 52" fill="none">
          <circle class="thanks__circle" cx="26" cy="26" r="24" stroke="currentColor" stroke-width="3" />
          <path class="thanks__tick" d="M15 27l7 7 15 -16" stroke="currentColor" stroke-width="4" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
      </div>
      <p class="kicker">Anfrage eingegangen</p>
      <h1 class="display thanks__headline">Vielen Dank!</h1>
      <p class="thanks__text">
        Ihre Anfrage ist bei uns eingegangen. Ein ZAPF Fachberater aus Ihrer Region meldet sich
        <strong>innerhalb kurzer Zeit</strong> bei Ihnen – mit Ihrem persönlichen, unverbindlichen
        Festpreis-Angebot.
      </p>

      <div class="thanks__next">
        <h2 class="thanks__next-title">So geht es jetzt weiter</h2>
        <ol class="thanks__steps">
          <li>Wir prüfen Ihre Angaben und ordnen Sie dem richtigen Fachberater zu.</li>
          <li>Ihr Berater kontaktiert Sie telefonisch oder per E-Mail.</li>
          <li>Sie erhalten Ihr Festpreis-Angebot – und entscheiden in Ruhe.</li>
        </ol>
      </div>

      <p class="thanks__phone">
        Sie möchten nicht warten? Rufen Sie uns direkt an:<br />
        <a href={`tel:${CONTACT.phoneLink}`}>{CONTACT.phoneDisplay}</a>
      </p>
    </div>
  </main>
  <Footer />

  {/* Conversion nur feuern, wenn der Funnel wirklich abgeschlossen wurde
      (Flag aus dem Formular) – verhindert Fehl-Conversions durch Direktaufrufe. */}
  <script>
    try {
      if (sessionStorage.getItem('zapf_lead_ok') === '1') {
        sessionStorage.removeItem('zapf_lead_ok');
        (window as any).__zapfTrackConversion?.();
      }
    } catch {
      /* noop */
    }
  </script>
</Base>

<style>
  .thanks {
    background: var(--concrete);
    min-height: 100vh;
    display: flex;
    align-items: center;
    padding-block: 8rem 4rem;
  }

  .thanks__inner {
    max-width: 42rem;
    text-align: center;
  }

  .thanks__check {
    display: inline-block;
    width: 4.5rem;
    color: var(--success);
    margin-bottom: 1.5rem;
  }

  .thanks__circle {
    stroke-dasharray: 160;
    stroke-dashoffset: 160;
    animation: thanks-draw 0.7s var(--ease-out) 0.2s forwards;
  }

  .thanks__tick {
    stroke-dasharray: 40;
    stroke-dashoffset: 40;
    animation: thanks-draw 0.45s var(--ease-out) 0.85s forwards;
  }

  @keyframes thanks-draw {
    to {
      stroke-dashoffset: 0;
    }
  }

  .thanks__headline {
    font-size: clamp(2.4rem, 6vw, 3.6rem);
    margin-top: 0.9rem;
  }

  .thanks__text {
    margin: 1.25rem auto 0;
    font-size: 1.1rem;
    line-height: 1.65;
    color: var(--ink-soft);
    max-width: 34rem;
  }

  .thanks__next {
    margin-top: 2.5rem;
    background: var(--white);
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    padding: 1.75rem 2rem;
    text-align: left;
    box-shadow: var(--shadow-card);
  }

  .thanks__next-title {
    font-size: 1.05rem;
    margin-bottom: 0.9rem;
  }

  .thanks__steps {
    margin: 0;
    padding-left: 1.25rem;
    display: grid;
    gap: 0.5rem;
    font-size: 0.95rem;
    color: var(--gray);
  }

  .thanks__steps li::marker {
    font-weight: 800;
    color: var(--red);
  }

  .thanks__phone {
    margin-top: 2.25rem;
    font-size: 0.95rem;
    color: var(--gray);
  }

  .thanks__phone a {
    display: inline-block;
    margin-top: 0.35rem;
    font-family: var(--font-display);
    font-size: 1.6rem;
    color: var(--ink);
    text-decoration: none;
  }

  .thanks__phone a:hover {
    color: var(--red);
  }
</style>
