# ============================================================
# ZAPF Fertiggaragen Landingpage – Konfiguration
# Kopie als ".env" anlegen und Werte eintragen.
# Alle Variablen mit PUBLIC_ landen im Client-Bundle.
# ============================================================

# --- HubSpot (Pflicht für Lead-Übermittlung) ---
# Portal-ID: HubSpot → Einstellungen → Konto & Abrechnung → Konto-ID (Hub-ID)
PUBLIC_HUBSPOT_PORTAL_ID=
# Form-GUID: HubSpot → Marketing → Formulare → Formular öffnen → ID aus der URL
PUBLIC_HUBSPOT_FORM_GUID=

# --- Google Ads Conversion-Tracking ---
# z. B. AW-123456789
PUBLIC_GADS_ID=
# Conversion-Label des Lead-Events, z. B. AbC-D_efG-h12_34-567
PUBLIC_GADS_CONVERSION_LABEL=

# --- Google Analytics 4 ---
# z. B. G-XXXXXXXXXX
PUBLIC_GA4_ID=

# --- Kontakt ---
# Anzeigenummer (sichtbar) und tel:-Link-Nummer
PUBLIC_PHONE_DISPLAY=0921 601-0
PUBLIC_PHONE_LINK=+4992160100
